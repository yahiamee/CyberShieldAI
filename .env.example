# Reference values only. Export variables in your shell before starting.
# Generate SECRET_KEY with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Optional first-run administrator. Remove the password from the environment after creation.
CYBERSHIELD_ADMIN_USERNAME=admin
CYBERSHIELD_ADMIN_EMAIL=admin@localhost
CYBERSHIELD_ADMIN_PASSWORD=
# Set to the absolute PEM path of your trusted ZAP root CA for HTTPS proxy scans.
ZAP_CA_BUNDLE=
